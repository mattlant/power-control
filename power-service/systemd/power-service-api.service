[Unit]
Description=Power service HTTPS status API
After=power-service-broker.service
Requires=power-service-broker.service
[Service]
User=power-service-api
Group=power-service-api
ExecStart=/usr/local/bin/power-service-api --config /etc/power-service/api.toml
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/power-service
[Install]
WantedBy=multi-user.target
